<UserControl x:Class="HonorBridge.Client.Wpf.Views.GameTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HonorBridge.Client.Wpf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1024">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Card Template -->
        <DataTemplate x:Key="CardTemplate">
            <Border Width="60" Height="90" Background="White" CornerRadius="5" BorderBrush="#333" BorderThickness="1" Margin="2">
                <Grid>
                    <!-- Top Left Rank/Suit -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2">
                        <TextBlock Text="{Binding Rank}" FontWeight="Bold" FontSize="14" Foreground="{Binding Color}"/>
                        <TextBlock Text="{Binding SuitSymbol}" FontSize="12" Foreground="{Binding Color}"/>
                    </StackPanel>
                    
                    <!-- Center Suit -->
                    <TextBlock Text="{Binding SuitSymbol}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Color}"/>
                    
                    <!-- Bottom Right Rank/Suit (Rotated) -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <RotateTransform Angle="180"/>
                        </StackPanel.RenderTransform>
                        <TextBlock Text="{Binding Rank}" FontWeight="Bold" FontSize="14" Foreground="{Binding Color}"/>
                        <TextBlock Text="{Binding SuitSymbol}" FontSize="12" Foreground="{Binding Color}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#0A420A"> <!-- Green Felt -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar / North -->
            <RowDefinition Height="*"/>    <!-- Play Area -->
            <RowDefinition Height="Auto"/> <!-- Hand / South -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/> <!-- West Info -->
            <ColumnDefinition Width="*"/>   <!-- Table -->
            <ColumnDefinition Width="200"/> <!-- East Info -->
        </Grid.ColumnDefinitions>

        <!-- Status Bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#33000000" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding State.RoomId, StringFormat='Room: {0}'}" Foreground="White" Margin="0,0,20,0"/>
                <TextBlock Text="{Binding State.Phase, StringFormat='Phase: {0}'}" Foreground="White" Margin="0,0,20,0"/>
                <TextBlock Text="{Binding State.Declarer, StringFormat='Declarer: {0}'}" Foreground="White" Margin="0,0,20,0"/>
                 <TextBlock Text="{Binding State.Contract, StringFormat='Contract: {0}'}" Foreground="Yellow" FontWeight="Bold" Margin="0,0,20,0"/>
            </StackPanel>
        </Border>

            <!-- North Seat -->
        <Border Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Margin="0,40,0,0">
            <StackPanel>
                <Button Command="{Binding SitCommand}" CommandParameter="North" Content="Sit North" Visibility="{Binding State.Seats[North], Converter={StaticResource NullToVis}}" />
                <TextBlock Text="{Binding State.Seats[North]}" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold"/>
                
                <!-- Last Call Bubble -->
                <Border Background="White" CornerRadius="10" Padding="5" Margin="0,5,0,0" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                             <Setter Property="Visibility" Value="Collapsed"/>
                             <Style.Triggers>
                                 <DataTrigger Binding="{Binding State.Phase}" Value="Bidding">
                                     <Setter Property="Visibility" Value="Visible"/>
                                 </DataTrigger>
                                 <DataTrigger Binding="{Binding LastCallNorth}" Value="">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                 </DataTrigger>
                             </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding LastCallNorth}" FontWeight="Bold" Foreground="Black"/>
                </Border>
                
                <!-- Dummy Hand (if visible) -->
                <ItemsControl ItemsSource="{Binding DummyHand}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                             <Button Command="{Binding DataContext.PlayCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                     CommandParameter="{Binding Id}"
                                     Content="{Binding}"
                                     ContentTemplate="{StaticResource CardTemplate}"
                                     Margin="2" Padding="0" BorderThickness="0" Background="Transparent"
                                     RenderTransformOrigin="0.5,0.5">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                         <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                       <TranslateTransform Y="-5"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                     <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="-35,0,0,0"/> <!-- OVERLAP CARDS -->
                            <Setter Property="Panel.ZIndex" Value="0"/> <!-- Default -->
                             <!-- Typically later items are on top in StackPanel naturally if ZIndex isn't forced inverse? -->
                             <!-- Actually StackPanel paints in order. So 2nd card covers right side of 1st card. -->
                             <!-- This is standard spread. -->
                             <Style.Triggers>
                                 <Trigger Property="IsMouseOver" Value="True">
                                     <Setter Property="Panel.ZIndex" Value="100"/>
                                 </Trigger>
                             </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- West Seat -->
        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="20,0,0,0">
             <Button Command="{Binding SitCommand}" CommandParameter="West" Content="Sit West" Visibility="{Binding State.Seats[West], Converter={StaticResource NullToVis}}" />
             <TextBlock Text="{Binding State.Seats[West]}" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold"/>
             
             <!-- Last Call Bubble -->
             <Border Background="White" CornerRadius="10" Padding="5" Margin="0,5,0,0" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                             <Setter Property="Visibility" Value="Collapsed"/>
                             <Style.Triggers>
                                 <DataTrigger Binding="{Binding State.Phase}" Value="Bidding">
                                     <Setter Property="Visibility" Value="Visible"/>
                                 </DataTrigger>
                                 <DataTrigger Binding="{Binding LastCallWest}" Value="">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                 </DataTrigger>
                             </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding LastCallWest}" FontWeight="Bold" Foreground="Black"/>
                </Border>
        </StackPanel>

        <!-- East Seat -->
        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
             <Button Command="{Binding SitCommand}" CommandParameter="East" Content="Sit East" Visibility="{Binding State.Seats[East], Converter={StaticResource NullToVis}}" />
             <TextBlock Text="{Binding State.Seats[East]}" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold"/>
             
             <!-- Last Call Bubble -->
             <Border Background="White" CornerRadius="10" Padding="5" Margin="0,5,0,0" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                             <Setter Property="Visibility" Value="Collapsed"/>
                             <Style.Triggers>
                                 <DataTrigger Binding="{Binding State.Phase}" Value="Bidding">
                                     <Setter Property="Visibility" Value="Visible"/>
                                 </DataTrigger>
                                 <DataTrigger Binding="{Binding LastCallEast}" Value="">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                 </DataTrigger>
                             </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding LastCallEast}" FontWeight="Bold" Foreground="Black"/>
             </Border>
        </StackPanel>

        <!-- South Seat (Me) -->
        <Border Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" Margin="0,0,0,20">
            <StackPanel>
                 <Button Command="{Binding SitCommand}" CommandParameter="South" Content="Sit South" Visibility="{Binding State.Seats[South], Converter={StaticResource NullToVis}}" />
                 <TextBlock Text="{Binding State.Seats[South]}" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold"/>
                 
                 <!-- Last Call Bubble -->
                 <Border Background="White" CornerRadius="10" Padding="5" Margin="0,5,0,0" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                 <Setter Property="Visibility" Value="Collapsed"/>
                                 <Style.Triggers>
                                     <DataTrigger Binding="{Binding State.Phase}" Value="Bidding">
                                         <Setter Property="Visibility" Value="Visible"/>
                                     </DataTrigger>
                                     <DataTrigger Binding="{Binding LastCallSouth}" Value="">
                                          <Setter Property="Visibility" Value="Collapsed"/>
                                     </DataTrigger>
                                 </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding LastCallSouth}" FontWeight="Bold" Foreground="Black"/>
                 </Border>
                 
                 <!-- My Hand -->
                 <ItemsControl ItemsSource="{Binding MyHand}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.PlayCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding Id}"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource CardTemplate}"
                                    Margin="-30,0,0,0" Padding="0" BorderThickness="0" Background="Transparent"
                                    RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <TranslateTransform X="0" Y="0"/>
                                </Button.RenderTransform>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                       <TranslateTransform Y="-20"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                     <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="-35,0,0,0"/> <!-- OVERLAP CARDS -->
                            <Setter Property="Panel.ZIndex" Value="0"/> <!-- Default -->
                             <!-- Typically later items are on top in StackPanel naturally if ZIndex isn't forced inverse? -->
                             <!-- Actually StackPanel paints in order. So 2nd card covers right side of 1st card. -->
                             <!-- This is standard spread. -->
                             <Style.Triggers>
                                 <Trigger Property="IsMouseOver" Value="True">
                                     <Setter Property="Panel.ZIndex" Value="100"/>
                                 </Trigger>
                             </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Center Table (Trick) -->
        <Grid Grid.Row="1" Grid.Column="1">
            
            <!-- TRICK CARDS -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="300">
                   <!-- North Card -->
                <ContentControl Content="{Binding CurrentTrick[North]}" ContentTemplate="{StaticResource CardTemplate}" 
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                                Visibility="{Binding CurrentTrick[North], Converter={StaticResource NullToVis}}"/>
                
                <!-- South Card -->
                <ContentControl Content="{Binding CurrentTrick[South]}" ContentTemplate="{StaticResource CardTemplate}" 
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                                Visibility="{Binding CurrentTrick[South], Converter={StaticResource NullToVis}}"/>

                <!-- West Card -->
                <ContentControl Content="{Binding CurrentTrick[West]}" ContentTemplate="{StaticResource CardTemplate}" 
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                                Visibility="{Binding CurrentTrick[West], Converter={StaticResource NullToVis}}"/>

                <!-- East Card -->
                <ContentControl Content="{Binding CurrentTrick[East]}" ContentTemplate="{StaticResource CardTemplate}" 
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                                Visibility="{Binding CurrentTrick[East], Converter={StaticResource NullToVis}}"/>
            </Grid>
            
            <!-- WINNER ARROW OVERLAY -->
            <Grid IsHitTestVisible="False">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State.LastTrickWinner, Converter={StaticResource NullToVis}}" Value="Visible">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                             <!-- Only show if LastTrickWinner is NOT null/empty -->
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <!-- Arrow pointing to North -->
                <Path Data="M 0,20 L 10,0 L 20,20 Z" Fill="#FFD700" Stroke="Black" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                     <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding State.LastTrickWinner}" Value="North"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                </Path>
                
                <!-- Arrow pointing to South -->
                <Path Data="M 0,0 L 10,20 L 20,0 Z" Fill="#FFD700" Stroke="Black" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                     <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding State.LastTrickWinner}" Value="South"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                </Path>

                <!-- Arrow pointing to West -->
                <Path Data="M 20,0 L 0,10 L 20,20 Z" Fill="#FFD700" Stroke="Black" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                     <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding State.LastTrickWinner}" Value="West"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                </Path>

                <!-- Arrow pointing to East -->
                <Path Data="M 0,0 L 20,10 L 0,20 Z" Fill="#FFD700" Stroke="Black" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                     <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding State.LastTrickWinner}" Value="East"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                </Path>
            </Grid>
            <!-- Bidding Box Overlay (Visible during Bidding phase) -->
            <Border Background="#DD000000" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State.Phase}" Value="Bidding">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Bidding" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <!-- Bidding Box Grid -->
                    <ItemsControl ItemsSource="{Binding BiddingBox}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 5 Columns for C, D, H, S, NT. Plus Pass/X/XX will flow -->
                                <UniformGrid Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding BidCommand}" Content="{Binding Label}" 
                                        IsEnabled="{Binding IsEnabled}"
                                        Margin="2" Padding="5" FontWeight="Bold" Width="40" Height="30"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Score Board (Side) -->
        <Border Grid.Row="2" Grid.Column="2" Background="#CC000000" Margin="10" Padding="10" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="SCOREBOARD" Foreground="#AAA" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NS" Grid.Column="0" Foreground="CYAN" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="-" Grid.Column="1" Foreground="Gray" Margin="5,0"/>
                    <TextBlock Text="EW" Grid.Column="2" Foreground="MAGENTA" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding State.TricksNS}" Grid.Column="0" Foreground="White" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text=":" Grid.Column="1" Foreground="Gray" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Text="{Binding State.TricksEW}" Grid.Column="2" Foreground="White" FontSize="20" HorizontalAlignment="Center"/>
                </Grid>
               
            </StackPanel>
        </Border>

        <!-- GAME OVER / SCORING OVERLAY -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="#EE000000" d:Visibility="Visible">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.Phase}" Value="Scoring">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <Grid>
                 <!-- Fireworks Background (Only if Winner) -->
                 <!-- Bind IsPlaying to IsWinner. Also keep Visibility for safety but IsPlaying triggers the anim -->
                 <local:FireworksControl x:Name="Fireworks" IsHitTestVisible="False" 
                                        Visibility="{Binding IsWinner, Converter={StaticResource BoolToVis}}"
                                        IsPlaying="{Binding IsWinner}"/>

                <Border Background="White" CornerRadius="10" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="400">
                    <StackPanel>
                        <!-- Winner Banner -->
                        <Border Background="#FFD700" CornerRadius="5" Padding="10" Margin="0,0,0,20" Visibility="{Binding IsWinner, Converter={StaticResource BoolToVis}}">
                             <TextBlock Text="{Binding WinnerName, StringFormat='WINNER: {0}!'}" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center"/>
                        </Border>
                    
                        <TextBlock Text="HAND COMPLETE" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="{Binding State.Contract, StringFormat='Contract: {0}'}" FontSize="18" Foreground="#555" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding State.LastScore}" FontSize="28" FontWeight="Bold" Foreground="#007ACC" HorizontalAlignment="Center" Margin="0,10,0,20" TextWrapping="Wrap" TextAlignment="Center"/>

                        <!-- Restart Button in Game View -->
                        <!-- Access MainViewModel command via Window DataContext -->
                        <Button Command="{Binding DataContext.NewGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                Content="Play Again (Random Hand)" 
                                Padding="15,10" Background="#007ACC" Foreground="White" FontWeight="Bold" Margin="0,10,0,0"
                                HorizontalAlignment="Center"/>
                            
                     <TextBlock Text="Or check menu for Options." FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,5"/>
                </StackPanel>
            </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
