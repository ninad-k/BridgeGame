<Application x:Class="HonorBridge.Client.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HonorBridge.Client.Wpf"
             xmlns:v="clr-namespace:HonorBridge.Client.Wpf.Views"
             xmlns:vm="clr-namespace:HonorBridge.Client.Wpf.ViewModels"
             xmlns:c="clr-namespace:HonorBridge.Client.Wpf.Converters">
    <Application.Resources>
        <c:NullToVisibilityConverter x:Key="NullToVis" />
        <DataTemplate DataType="{x:Type vm:LobbyViewModel}">
            <v:LobbyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameTableViewModel}">
            <v:GameTableView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <v:HelpView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <v:AboutView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HowToPlayViewModel}">
            <v:HowToPlayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </Application.Resources>
</Application>
